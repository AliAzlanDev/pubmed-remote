{
  "name": "pubmed-mcp-server-remote",
  "version": "1.0.2",
  "description": "Remote MCP server for PubMed database access with render.com support",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "pubmed-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "start:remote": "MCP_TRANSPORT=sse node dist/index.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pubmed",
    "ncbi",
    "biomedical",
    "research",
    "remote-mcp",
    "render",
    "sse"
  ],
  "author": "Claude",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.0",
    "zod": "^3.22.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
